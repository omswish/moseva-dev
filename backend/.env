# Port and Environment
PORT=5001
NODE_ENV=development

# Database Setup (PostgreSQL)
DATABASE_URL=postgres://postgres:sa@127.0.0.1:5432/moseva-dev

# JWT Configurations (HS256 Secret Keys)
ACCESS_TOKEN_SECRET=dev_access_token_secret_moseva_marketplace_32char_key
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=dev_refresh_token_secret_moseva_marketplace_32char_key
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS configurations (Comma-separated list of allowed clients)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
