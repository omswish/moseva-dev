# Port and Environment
PORT=5000
NODE_ENV=development

# Database Setup (PostgreSQL)
# Either specify a single connection string:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/service_marketplace
# Or individual credentials:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=service_marketplace
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configurations (HS256 Secret Keys)
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_minimum_32_characters_long
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_minimum_32_characters_long
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS configurations (Comma-separated list of allowed clients)
ALLOWED_ORIGINS=http://localhost:3000
